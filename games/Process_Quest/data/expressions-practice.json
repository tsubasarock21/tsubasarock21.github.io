          "goals": [
            "元の式と同じ値を表す、整理した式を求める",
            "式の値が0になるx・yの値を求める",
            "x・yに数を代入して、式の値を求める"
          ],
          "goalReason": "「簡単にする」は、どのx・yでも元と同じ値になる式に整理することです。等式ではないのでx・yを解く問題ではなく、代入する数も指定されていません。",
          "routes": [
            {
              "label": "2を3xと−yに掛け、−3(x＋2y)を残す",
              "work": "2*(3*x-y)",
              "template": "$-3*(x+2*y)"
            },
            {
              "label": "2を3xに掛け、−yと−3(x＋2y)を残す",
              "work": "6*x-y",
              "template": "$-3*(x+2*y)"
