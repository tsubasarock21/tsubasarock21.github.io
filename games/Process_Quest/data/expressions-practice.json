      "problem": {
        "title": "項と次数",
        "level": "基礎",
        "expr": {
          "group": "practice",
          "kind": "terms",
          "question": "次の式の項と次数を答えよう。",
          "display": "4*x^2-3*x+8",
          "original": "4*x^2-3*x+8",
          "goals": [
            "式をつくる各項と、式の次数を答える",
            "式の項が全部でいくつあるかを答える",
            "xの項とx²の項の係数を答える"
          ],
          "goalReason": "求めるのは各項と次数です。項の個数や係数だけでは答えがそろいません。",
          "routes": [
            {
              "label": "＋と−の区切りで、符号を含めて項を分ける",
              "work": "4*x^2-3*x+8",
              "template": "$"
            },
            {
              "label": "−の直後の項も、正の項として分ける",
              "work": "4*x^2+3*x+8",
              "template": "$"
            },
            {
              "label": "文字を含む部分だけを項として分ける",
              "work": "4*x^2-3*x",
              "template": "$"
            }
          ],
          "routeReason": "項は符号を含めて分けます。定数項も一つの項で、次数は最も高い項で決めます。",
          "workReason": "項は符号を含めて分けます。定数項も一つの項で、次数は最も高い項で決めます。",
          "verify": "各項の符号・定数項と、最大の次数を元の式と比べる",
          "calculationChoices": {
            "work": [
              [
                "4*x^2+3*x+8",
                "4*x^2-3*x"
              ],
              [
                "4*x^2-3*x+8",
                "4*x^2+3*x"
              ],
              [
                "4*x^2+3*x",
                "4*x^2-3*x+8"
              ]
            ],
            "answer": [
              "1",
              "3"
            ]
          },
          "verificationChoices": [
            "各項の符号・定数項と、最大の次数を元の式と比べる",
            "元の式と、選んだ項の個数を比べる",
            "元の式と、選んだ次数を比べる"
          ],
          "workQuestion": "符号も含めて、この式の項を選ぼう。"
        }
      }
