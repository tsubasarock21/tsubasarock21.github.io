      "problem": {
        "title": "分配法則を使う",
        "level": "応用",
        "expr": {
          "group": "practice",
          "kind": "calc",
          "question": "次の式を簡単にしよう。",
          "display": "2*(3*x-y)-3*(x+2*y)",
