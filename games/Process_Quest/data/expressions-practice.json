    {
      "id": 11,
      "problem": {
        "title": "同類項をまとめる",
        "level": "基礎",
        "expr": {
          "group": "practice",
          "kind": "calc",
          "question": "次の式を簡単にしよう。",
          "display": "5*a-2*b+3*a+6*b",
          "original": "5*a-2*b+3*a+6*b",
          "goals": [
            "元の式と同じ値を表す、整理した式を求める",
            "式の値が0になるa・bの値を求める",
            "a・bに数を代入して、式の値を求める"
          ],
          "goalReason": "「簡単にする」は、どのa・bでも元と同じ値になる式に整理することです。等式ではないのでa・bを解く問題ではなく、代入する数も指定されていません。",
          "routes": [
            {
              "label": "5aと3aをまとめ、−2b＋6bを残す",
              "work": "5*a+3*a",
              "template": "$-2*b+6*b"
            },
            {
              "label": "5aと−2bをまとめ、3a＋6bを残す",
              "work": "(5-2)*a",
              "template": "$+3*a+6*b"
            },
            {
              "label": "aの係数は5＋3、bの係数は2＋6でまとめる",
              "work": "(5+3)*a",
              "template": "$+(2+6)*b"
            }
          ],
          "routeReason": "aの項どうし、bの項どうしをまとめます。−2bの係数は−2なので、bの係数は−2＋6です。",
          "workReason": "aの項どうし、bの項どうしをまとめます。−2bの係数は−2なので、bの係数は−2＋6です。",
          "verify": "aの項・bの項を、それぞれ元の式と比べる",
          "calculationChoices": {
            "work": [
              [
                "2*a",
                "8"
              ],
              [
                "7*a",
                "3"
              ],
              [
                "2*a",
                "8"
              ]
            ],
            "answer": [
              "8*a+8*b",
              "8*a-4*b"
            ]
          },
          "verificationChoices": [
            "aの項・bの項を、それぞれ元の式と比べる",
            "aの項の係数を、元の式と比べる",
            "bの項の係数を、元の式と比べる"
          ],
          "workQuestion": "5a＋3aを計算すると？"
        },
        "skipIntro": true
      }
