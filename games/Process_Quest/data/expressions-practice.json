            {
              "label": "2を3xと−yに掛け、＋3(x＋2y)を残す",
              "work": "2*(3*x-y)",
              "template": "$+3*(x+2*y)"
            }
          ],
          "routeReason": "外の数は括弧内のすべての項に掛けます。−3も符号ごと各項に掛けます。",
          "workReason": "外の数は括弧内のすべての項に掛けます。−3も符号ごと各項に掛けます。",
          "verify": "二つの括弧を展開し、xとyの係数をそれぞれ比べる",
          "calculationChoices": {
            "work": [
              [
                "6*x-y",
                "6*x+2*y"
              ],
              [
                "6*x-2*y",
                "6*x+y"
              ],
              [
                "6*x-y",
                "6*x+2*y"
              ]
            ],
            "answer": [
              "3*x+4*y",
              "3*x-5*y"
            ]
          },
          "verificationChoices": [
            "二つの括弧を展開し、xとyの係数をそれぞれ比べる",
            "xの項の係数を、元の式と比べる",
            "yの項の係数を、元の式と比べる"
          ],
          "workQuestion": "選んだ括弧の外し方で、最初の部分をまとめると？"
        },
        "skipIntro": true
