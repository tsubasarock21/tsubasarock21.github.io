      "id": 305,
      "problem": {
        "title": "x軸上で交わる直線",
        "level": "難問",
        "skipIntro": true,
        "authored": {
          "id": "C3-33",
          "title": "x軸上で交わる直線",
          "group": "難問",
          "question": "点(−2, 3)を通り、直線y＝x−4とx軸上の同じ点で交わる。 一次関数の式を求めよう。",
          "answer": "y＝-1/2x＋2",
          "steps": [
            {
              "question": "直線y＝x−4とx軸の交点は？",
              "choices": [
                {
                  "id": "c1",
                  "text": "(4, 0)"
                },
                {
                  "id": "c2",
                  "text": "(0, −4)"
                },
                {
                  "id": "c3",
                  "text": "(−4, 0)"
                }
              ],
              "correctChoice": "c1",
              "explanation": "x軸上ではy＝0。0＝x−4よりx＝4。"
            },
            {
              "question": "傾きはどれ？",
              "choices": [
                {
                  "id": "c1",
                  "text": "-1/2"
                },
                {
                  "id": "c3",
                  "text": "3/2"
                },
                {
                  "id": "c2",
                  "text": "1/2"
                }
              ],
              "correctChoice": "c1",
              "explanation": "傾き＝yの増加量÷xの増加量＝(0−(3))÷(4−(-2))＝-1/2。"
            },
            {
              "question": "傾きが-1/2で点(-2, 3)を通るとき、切片bは？",
              "choices": [
                {
                  "id": "c1",
                  "text": "2"
                },
                {
                  "id": "c2",
                  "text": "4"
                },
                {
                  "id": "c3",
                  "text": "0"
                }
              ],
              "correctChoice": "c1",
              "explanation": "3＝-1/2×(-2)＋b より、b＝2。"
            },
            {
              "question": "条件を満たす式はどれ？",
              "choices": [
                {
                  "id": "c1",
                  "text": "y＝-1/2x＋2"
                },
                {
                  "id": "c2",
                  "text": "y＝1/2x＋2"
                },
                {
                  "id": "c3",
                  "text": "y＝-1/2x＋4"
                }
              ],
              "correctChoice": "c1",
              "explanation": "求めた傾きと切片を y＝ax＋b に入れる。"
            }
          ],
          "verification": {
            "question": "求めた直線が元の2条件を満たすことを確認すると？",
            "choices": [
              {
                "id": "c1",
                "text": "x＝−2でy＝3、x＝4でy＝0"
              },
              {
                "id": "c2",
                "text": "x＝−2でy＝3だけ確認すればよい"
              },
              {
                "id": "c3",
                "text": "切片が2なので、x軸との交点も(2,0)"
              }
            ],
            "correctChoice": "c1",
            "explanation": "y＝−(1/2)x＋2に代入すると、(−2,3)と(4,0)を通る。y＝x−4も(4,0)を通るので、x軸上の同じ点で交わる。"
          },
          "visual": null,
          "mathChecks": [
            {
