    {
      "id": 273,
      "problem": {
        "title": "水量の増え方",
        "level": "文章題",
        "skipIntro": true,
        "authored": {
          "id": "C3-01",
          "title": "水量の増え方",
          "group": "文章題",
          "question": "水が4 L入った水そうに一定の割合で注水すると、3分後に15.25 Lになった。1分あたりの増加量は？",
          "answer": "3.75 L/分",
          "steps": [
            {
              "question": "3分間で増えた水量は？",
              "choices": [
                {
                  "id": "c1",
                  "text": "12 L"
                },
                {
                  "id": "c2",
                  "text": "16 L"
                },
                {
                  "id": "c3",
                  "text": "20 L"
                }
              ],
              "correctChoice": "c1",
              "explanation": "16−4＝11.25 L。",
              "choiceFeedback": [
                "増えた量は15.25−4＝11.25 L。最初の4 Lを引く必要がある。",
                "15.25 Lは3分後の全体量で、増えた量ではない。",
                "最初の4 Lを足すと、増加量ではなくなる。"
              ]
            },
            {
              "question": "1分あたりの増加量は？",
              "choices": [
                {
                  "id": "c1",
                  "text": "3.75 L/分"
                },
                {
                  "id": "c3",
                  "text": "16/3 L/分"
                },
                {
                  "id": "c2",
                  "text": "12 L/分"
                }
              ],
              "correctChoice": "c1",
              "explanation": "12÷3＝4。",
              "choiceFeedback": [
                "11.25÷3＝3.75 L/分。",
                "3分で11.25 L増えたので、3を掛けるのではなく割る。",
                "4 Lは初めの水量で、1分あたりの増加量ではない。"
              ]
            }
          ],
          "verification": {
            "question": "1分あたり4 L増えるとして3分後を確認すると？",
            "choices": [
              {
                "id": "c1",
                "text": "4＋4×3＝16 L"
              },
              {
                "id": "c3",
                "text": "16＋4×3＝28 L"
              },
              {
                "id": "c2",
                "text": "4×3＝12 L"
              }
            ],
            "correctChoice": "c1",
            "explanation": "最初の4 Lも加える。"
          },
          "visual": null,
          "mathChecks": [
            "15.25-4=11.25",
            "11.25/3=3.75"
          ],
          "direct": {
            "question": "水が4 L入った水そうに一定の割合で注水すると、3分後に16 Lになった。1分あたりの増加量は？",
            "choices": [
              {
                "id": "c1",
                "text": "3.75 L/分"
              },
              {
                "id": "c3",
                "text": "16/3 L/分"
              },
              {
                "id": "c2",
                "text": "12 L/分"
              }
            ],
            "correctChoice": "c1",
            "explanation": "12÷3＝4。"
          }
        }
      }
    },
    {
      "id": 274,
      "problem": {
        "title": "水量を式にする",
        "level": "文章題",
        "skipIntro": true,
        "authored": {
          "id": "C3-02",
          "title": "水量を式にする",
          "group": "文章題",
          "question": "水が4 L入った水そうに毎分3.75 Lずつ注水する。注水開始からx分後の水量をy Lとする。満水になるまではどんな式で表せる？",
          "answer": "y＝3.75x＋4",
          "steps": [
            {
              "question": "最初の水量を含めた式は？",
              "choices": [
                {
                  "id": "c1",
                  "text": "y＝3.75x＋4"
                },
                {
                  "id": "c2",
                  "text": "y＝3.75x"
                },
                {
                  "id": "c3",
                  "text": "y＝3.75x−4"
                }
              ],
              "correctChoice": "c1",
              "explanation": "増えた水量4xに最初の4を加える。"
            }
          ],
          "verification": {
            "question": "式が条件を満たすことを確認するには？",
            "choices": [
              {
                "id": "c2",
                "text": "x＝0で0 Lになる"
              },
              {
                "id": "c3",
                "text": "xが増えるほど水が減る"
              },
              {
                "id": "c1",
                "text": "x＝0で4 L、1分ごとに4 L増える"
              }
            ],
            "correctChoice": "c1",
            "explanation": "初期値と増加量の両方を確認する。"
          },
          "visual": null,
          "mathChecks": [
            "y=3.75x+4"
          ],
          "direct": {
            "question": "水が4 L入った水そうに毎分4 Lずつ注水する。注水開始からx分後の水量をy Lとする。満水になるまではどんな式で表せる？",
            "choices": [
              {
                "id": "c1",
                "text": "y＝3.75x＋4"
              },
              {
                "id": "c2",
                "text": "y＝3.75x"
              },
              {
                "id": "c3",
                "text": "y＝3.75x−4"
              }
            ],
            "correctChoice": "c1",
            "explanation": "増えた水量4xに最初の4を加える。"
          }
        }
      }
    },
    {
      "id": 303,
      "problem": {
        "title": "移動グラフと速さ",
        "level": "文章題",
        "skipIntro": true,
        "authored": {
          "id": "C3-31",
          "title": "移動グラフと速さ",
          "group": "文章題",
          "question": "弟は10時に家を出発した。グラフは出発からの時間（分）と家からの道のり（m）を表し、(0,0)→(20,4000)→(50,7000)を線分で結ぶ。最初の20分は自転車、その後は徒歩で、各区間では一定の速さで休まず進む。自転車の分速を求めよう。",
          "answer": "200 m/分",
          "steps": [
            {
              "question": "最初の区間の道のり÷時間は？",
              "choices": [
                {
                  "id": "c2",
                  "text": "4000÷50＝80 m/分"
                },
                {
                  "id": "c3",
                  "text": "7000÷20＝350 m/分"
                },
                {
                  "id": "c1",
                  "text": "4000÷20＝200 m/分"
                }
              ],
              "correctChoice": "c1",
              "explanation": "同じ区間の道のりと所要時間を使う。"
            }
          ],
          "verification": {
            "question": "求めた速さで20分進むと？",
            "choices": [
              {
                "id": "c2",
                "text": "200＋20＝220 m"
              },
              {
                "id": "c1",
                "text": "200×20＝4000 m"
              },
              {
                "id": "c3",
                "text": "200÷20＝10 m"
              }
            ],
            "correctChoice": "c1",
            "explanation": "グラフの折れ曲がる点と一致する。"
          },
          "visual": {
            "type": "svg",
            "path": "assets/materials/chapter3/batch3-graphs/travel-problem.svg"
