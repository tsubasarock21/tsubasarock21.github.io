    {
      "id": 304,
      "problem": {
        "title": "途中で速さが変わる追いつき",
        "level": "文章題",
        "skipIntro": true,
        "authored": {
          "id": "C3-32",
          "title": "途中で速さが変わる追いつき",
          "group": "文章題",
          "question": "弟は10時に家を出発した。出発からの時間x（分）と家からの道のりy（m）のグラフは、(0,0)→(20,4000)→(50,7000)を線分で結ぶ。各区間では一定の速さで休まず進む。姉は10時10分に自転車で家を出発し、分速300 mで同じ道を同じ方向に進む。姉が弟に追いつく時刻と家からの道のりを求めよう。",
          "answer": "10時25分、4500 m",
          "steps": [
            {
              "question": "弟の出発20分後、姉は追いついている？",
              "choices": [
                {
                  "id": "c2",
                  "text": "両方4000 mで追いついている"
                },
                {
                  "id": "c3",
                  "text": "姉6000 mなので追い越している"
                },
                {
                  "id": "c1",
                  "text": "弟4000 m、姉3000 mなので、まだ"
                }
              ],
              "correctChoice": "c1",
              "explanation": "姉の出発時に弟は2000 m先にいる。10時20分までは速さの差が100 m/分で、差は2000 mから1000 mへ縮まるが0にはならない。10時20分時点で弟4000 m、姉3000 mなので、追いつくのは次の区間。"
            },
            {
              "question": "20分以降の弟と姉の道のりの式は？",
              "choices": [
                {
                  "id": "c2",
                  "text": "弟y＝100x、姉y＝300x"
                },
                {
                  "id": "c3",
                  "text": "弟y＝200x、姉y＝300(x−10)"
                },
                {
                  "id": "c1",
                  "text": "弟y＝100x＋2000、姉y＝300(x−10)"
                }
              ],
              "correctChoice": "c1",
              "explanation": "徒歩の速さは(7000−4000)÷(50−20)＝100 m/分。弟はy＝4000＋100(x−20)＝100x＋2000（20≦x≦50）。姉の経過時間はx−10なので、y＝300(x−10)（x≧10）。"
            },
            {
              "question": "2つの道のりが等しくなる時刻と地点は？",
              "choices": [
                {
                  "id": "c3",
                  "text": "10時30分、6000 m"
                },
                {
                  "id": "c1",
                  "text": "10時25分、4500 m"
                },
                {
                  "id": "c2",
                  "text": "10時20分、4000 m"
                }
              ],
              "correctChoice": "c1",
              "explanation": "100x＋2000＝300(x−10)より200x＝5000、x＝25。y＝4500。"
            }
          ],
          "verification": {
            "question": "10時25分に本当に追いつくか、2人の道のりを比べると？",
            "choices": [
              {
                "id": "c2",
                "text": "弟4500 m、姉7500 mで一致しない"
              },
              {
                "id": "c1",
                "text": "弟4500 m、姉4500 mで一致する"
              },
              {
                "id": "c3",
                "text": "弟2500 m、姉4500 mで一致しない"
              }
            ],
            "correctChoice": "c1",
            "explanation": "弟：4000＋100×(25−20)＝4500。姉：300×(25−10)＝4500。20≦25≦50なので徒歩区間の式が使える。"
          },
          "visual": {
            "type": "svg",
            "path": "assets/materials/chapter3/batch3-graphs/travel-problem.svg"
          },
          "mathChecks": [],
          "direct": {
            "question": "弟は10時に家を出発した。出発からの時間x（分）と家からの道のりy（m）のグラフは、(0,0)→(20,4000)→(50,7000)を線分で結ぶ。各区間では一定の速さで休まず進む。姉は10時10分に家を出発し、分速300 mで同じ道を同じ方向に進む。姉が弟に追いつく時刻と家からの道のりを求めよう。",
            "choices": [
              {
                "id": "c3",
                "text": "10時30分、6000 m",
                "value": [
                  30,
                  6000
                ]
              },
              {
                "id": "c1",
                "text": "10時25分、4500 m",
                "value": [
                  25,
                  4500
                ]
              },
              {
                "id": "c2",
                "text": "10時20分、4000 m",
                "value": [
                  20,
                  4000
                ]
              }
            ],
            "correctChoice": "c1",
            "explanation": "弟は徒歩で分速100 m、姉は自転車で分速300 m。10時20分時点で弟は2000 m先にいる。10時からx分後として 300(x−10)=100x+2000 を解くと x=25、距離は4500 m。したがって10時25分に追いつく。"
          },
          "flowPolicy": "各手順は正しい解法の原稿。前段を誤答した場合は見直しへ戻すか、その選択から計算を続ける。黙って正しい中間値へ切り替えない。",
          "solutionVisual": {
            "asset": "",
            "sisterStart": [
              10,
              0
            ],
            "intersection": [
              25,
              4500
            ]
          }
        }
      }
