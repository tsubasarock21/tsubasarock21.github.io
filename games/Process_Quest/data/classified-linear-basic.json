    {
      "id": 280,
      "problem": {
        "title": "グラフから式",
        "level": "基礎",
        "skipIntro": true,
        "authored": {
          "id": "C3-08",
          "title": "グラフから式",
          "group": "基礎",
          "question": "グラフには点(0, 1)、(2, 5)を通る直線が描かれている。 一次関数の式を求めよう。",
          "answer": "y＝2x＋1",
          "steps": [
            {
              "question": "傾きはどれ？",
              "choices": [
                {
                  "id": "c3",
                  "text": "4"
                },
                {
                  "id": "c1",
                  "text": "2"
                },
                {
                  "id": "c2",
                  "text": "-2"
                }
              ],
              "correctChoice": "c1",
              "explanation": "傾き＝yの増加量÷xの増加量＝(5−(1))÷(2−(0))＝2。"
            },
            {
              "question": "傾きが2で点(0, 1)を通るとき、切片bは？",
              "choices": [
                {
                  "id": "c2",
                  "text": "3"
                },
                {
                  "id": "c3",
                  "text": "-1"
                },
                {
                  "id": "c1",
                  "text": "1"
                }
              ],
              "correctChoice": "c1",
              "explanation": "1＝2×(0)＋b より、b＝1。"
            },
            {
              "question": "条件を満たす式はどれ？",
              "choices": [
                {
                  "id": "c2",
                  "text": "y＝-2x＋1"
                },
                {
                  "id": "c1",
                  "text": "y＝2x＋1"
                },
                {
                  "id": "c3",
                  "text": "y＝2x＋3"
                }
              ],
              "correctChoice": "c1",
              "explanation": "求めた傾きと切片を y＝ax＋b に入れる。"
            }
          ],
          "verification": {
            "question": "選んだ式を元の条件と照合するとき、確認する内容は？",
            "choices": [
              {
                "id": "c1",
                "text": "2点の両方を通る"
              },
              {
                "id": "c2",
                "text": "切片だけを確認する"
              },
              {
                "id": "c3",
                "text": "式にxとyがあればよい"
              }
            ],
            "correctChoice": "c1",
            "explanation": "x＝0のときy＝1、x＝2のときy＝5。傾きは2。"
          },
          "visual": {
            "type": "svg",
            "path": "assets/materials/chapter3/C3-08.svg"
          },
          "mathChecks": [
            {
              "kind": "line",
              "a": "2",
              "b": "1",
              "points": [
                [
                  0,
                  1
                ],
                [
                  2,
                  5
                ]
              ]
            }
          ],
          "direct": {
            "question": "グラフには点(0, 1)、(2, 5)を通る直線が描かれている。 一次関数の式を求めよう。",
            "choices": [
              {
                "id": "c2",
                "text": "y＝-2x＋1"
              },
              {
                "id": "c1",
                "text": "y＝2x＋1"
              },
              {
                "id": "c3",
                "text": "y＝2x＋3"
              }
            ],
            "correctChoice": "c1",
            "explanation": "傾きは「yの増加量÷xの増加量」で求める。1＝2×(0)＋b より、b＝1。 その計算で得た傾きと切片を y＝ax＋b に入れる。 上の計算で得られる傾きと切片を y＝ax＋b に入れる。"
