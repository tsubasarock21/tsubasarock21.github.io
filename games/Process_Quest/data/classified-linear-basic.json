      "problem": {
        "title": "変化の割合",
        "level": "基礎",
        "skipIntro": true,
        "authored": {
          "id": "C3-03",
          "title": "変化の割合",
          "group": "基礎",
          "question": "一次関数 y＝−3x＋7 の変化の割合を求めよう。",
          "answer": "−3",
          "steps": [
            {
              "question": "xが1増えるとyはどう変わる？",
              "choices": [
                {
                  "id": "c1",
                  "text": "3減る"
                },
                {
                  "id": "c2",
                  "text": "3増える"
                },
                {
                  "id": "c3",
                  "text": "7増える"
                }
              ],
              "correctChoice": "c1",
              "explanation": "xの係数が−3なので、変化の割合は−3。"
            }
          ],
          "verification": {
            "question": "x＝0とx＝2を使って確かめると？",
            "choices": [
              {
                "id": "c1",
                "text": "(1−7)÷(2−0)＝−3"
              },
              {
                "id": "c2",
                "text": "(7−1)÷2＝3"
              },
              {
                "id": "c3",
                "text": "1−7＝−6だけで終える"
              }
            ],
            "correctChoice": "c1",
            "explanation": "yの増加量をxの増加量で割る。"
          },
          "visual": null,
          "mathChecks": [],
          "direct": {
            "question": "一次関数 y＝−3x＋7 の変化の割合を求めよう。",
            "choices": [
              {
                "id": "c1",
                "text": "−3"
              },
              {
                "id": "c2",
                "text": "3"
              },
              {
                "id": "c3",
                "text": "7"
              }
            ],
            "correctChoice": "c1",
            "explanation": "xの係数が−3なので、変化の割合は−3。"
          }
        }
      }
